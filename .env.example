# 复制为 .env 后填写。不要提交真实密钥。
APP_NAME=研究生会 AI 协同工作台
ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 本机开发（Homebrew PostgreSQL，trust 认证）
DATABASE_URL=postgresql+psycopg://research@127.0.0.1:5432/research_union
# Docker Compose 内使用：postgresql+psycopg://research:research@db:5432/research_union
REDIS_URL=redis://127.0.0.1:6379/0
# Docker Compose 内使用：redis://redis:6379/0

FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
MAX_UPLOAD_MB=25

# 云端模型（OpenAI 兼容接口）。未配置时知识库仍可上传/关键词检索，但 AI 对话不可用。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# 生产容器内使用 /app/storage；本机默认使用项目根目录 storage/
# STORAGE_ROOT=/app/storage
